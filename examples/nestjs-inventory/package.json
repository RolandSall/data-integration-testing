{
  "name": "example-nestjs-inventory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "generate": "prisma generate --schema prisma/postgresql.prisma && prisma generate --schema prisma/sqlite.prisma",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/run-matrix.ts",
    "test:sqlite": "node --experimental-strip-types scripts/run-matrix.ts --sqlite",
    "test:external": "node --experimental-strip-types scripts/run-matrix.ts --external",
    "verify": "bun run generate && bun run typecheck && bun run test",
    "verify:sqlite": "bun run generate && bun run typecheck && bun run test:sqlite",
    "test:per-file": "node --experimental-strip-types scripts/run-matrix.ts --per-file",
    "migrate": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@prisma/client": "6.19.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.28"
  },
  "devDependencies": {
    "@integration-testing/data-isolation": "workspace:*",
    "@integration-testing/testcontainers": "0.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/jest": "^30.0.0",
    "jest": "~30.4.2",
    "jest-environment-node": "~30.4.1",
    "prisma": "6.19.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "esbuild": "0.28.1"
  }
}
