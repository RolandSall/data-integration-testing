{
  "name": "data-integration-testing-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/data build",
    "generate": "bun run --cwd examples/without-testcontainers generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages examples scripts --max-warnings=0",
    "test": "bun run --cwd packages/data test",
    "test:examples": "bun run --cwd examples/without-testcontainers test",
    "test:docker": "bun run --cwd examples/with-testcontainers test",
    "pack:check": "bun scripts/verify-package.ts",
    "verify": "bun run audit && bun run build && bun run generate && bun run typecheck && bun run lint && bun run test && bun run test:examples && bun run pack:check",
    "pack:check:docker": "bun scripts/verify-package.ts --docker",
    "audit": "bun audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "deepmerge-ts": "8.0.0"
  }
}
