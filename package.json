{
  "name": "data-integration-testing-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/data build",
    "generate": "bun run --cwd examples/without-testcontainers generate && bun run --cwd examples/nestjs-inventory generate",
    "typecheck": "tsc --noEmit && bun run --cwd examples/nestjs-inventory typecheck",
    "lint": "eslint packages examples scripts --max-warnings=0",
    "test": "bun run --cwd packages/data test",
    "test:examples": "bun run --cwd examples/without-testcontainers test",
    "test:docker": "bun run --cwd examples/with-testcontainers test",
    "pack:check": "bun scripts/verify-package.ts",
    "verify": "bun run audit && bun run build && bun run generate && bun run typecheck && bun run lint && bun run test && bun run test:runners && bun run test:examples && bun run pack:check",
    "pack:check:docker": "bun scripts/verify-package.ts --docker",
    "audit": "bun audit",
    "test:runners": "bun scripts/verify-runners.ts",
    "test:runners:minimum": "bun scripts/verify-runner-minimum.ts",
    "test:consumer": "bun scripts/verify-demo.ts",
    "test:consumer:sqlite": "bun scripts/verify-demo.ts --sqlite"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "~4.1.11",
    "jest": "~30.4.2",
    "jest-environment-node": "~30.4.1",
    "@jest/types": "^30.0.0",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.1",
    "typeorm": "~0.3.28",
    "pg": "^8.16.3",
    "@integration-testing/data": "workspace:*"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "deepmerge-ts": "8.0.0"
  }
}
